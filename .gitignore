# ==========================================
# BACKEND (Java Spring Boot)
# ==========================================
backend/target/
backend/!.mvn/wrapper/maven-wrapper.jar
backend/!**/src/main/**/target/
backend/!**/src/test/**/target/

# STS, IntelliJ, NetBeans, VS Code (Specific to backend folder)
backend/.apt_generated
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings
backend/.springBeans
backend/.sts4-cache
backend/.idea
backend/*.iws
backend/*.iml
backend/*.ipr
backend/.vscode/

# Sensitive files
backend/src/main/resources/application.properties
backend/.env
backend/.env.local
backend/.env.*.local
backend/.env.example

# ==========================================
# FRONTEND (Node/React/Vue)
# ==========================================
frontend/node_modules/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.env.example
frontend/build/
frontend/dist/
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.cache/
frontend/coverage/
frontend/.pnpm-store/

# ==========================================
# GENERAL (Root & OS)
# ==========================================
.pnpm-store/
.DS_Store
*.log
.idea/
.vscode/

# Claude Code local config (settings tự thay đổi theo permission grant)
.claude/